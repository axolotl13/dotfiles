# Mejor calidad de video + audio por defecto
# -f bestvideo+bestaudio/best
-f "bestvideo[vcodec^=av01]+bestaudio/bestvideo+bestaudio/best"
--merge-output-format mkv

# Raspberry Pi 3
# -f "bestvideo[vcodec^=avc1][height<=1080]+bestaudio/best"
# --merge-output-format mp4

# Cookies
--cookies-from-browser firefox

# Use this proxy
# --proxy 127.0.0.1:3128

# Metadata y subtítulos
--embed-thumbnail
--embed-metadata
--write-sub
--write-auto-sub
--sub-lang es,en
--convert-subs srt

# Organización de archivos
-o ~/Videos/%(title)s.%(ext)s

# Rendimiento
--concurrent-fragments 4
--retries 10

# No sobreescribir si ya existe
--no-overwrites
--continue
